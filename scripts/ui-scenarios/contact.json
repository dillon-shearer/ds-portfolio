{
  "name": "contact",
  "route": "/contact",
  "reducedMotion": true,
  "viewports": [
    { "width": 360, "height": 800 },
    { "width": 1440, "height": 1000 }
  ],
  "states": [
    {
      "name": "loaded",
      "ready": "form button[type='submit']",
      "assertions": [
        {
          "kind": "text",
          "selector": "h1",
          "includes": "Get in touch"
        },
        {
          "kind": "count",
          "selector": "form input[name='name'], form input[name='email'], form textarea[name='message']",
          "equals": 3
        },
        {
          "kind": "visible",
          "selector": "h2#elsewhere-heading"
        },
        {
          "kind": "eval",
          "expression": "Array.from(document.querySelectorAll('section[aria-labelledby=elsewhere-heading] a')).map((a) => a.textContent.trim() + ':' + getComputedStyle(a).fontSize).join('|')",
          "equals": "Email:20px|LinkedIn:20px|GitHub:20px"
        },
        {
          "kind": "eval",
          "expression": "(() => { const s = getComputedStyle(document.querySelector('form button[type=submit]')); return [s.fontSize, s.paddingTop, s.paddingRight, s.paddingBottom, s.paddingLeft].join(' '); })()",
          "equals": "12px 12px 24px 12px 24px"
        },
        {
          "kind": "eval",
          "expression": "document.documentElement.scrollWidth === document.documentElement.clientWidth",
          "equals": true
        },
        {
          "kind": "eval",
          "expression": "matchMedia('(prefers-reduced-motion: reduce)').matches",
          "equals": true
        }
      ],
      "actions": [
        { "action": "fill", "selector": "form input[name='name']", "value": "UI Evidence" },
        { "action": "focus", "selector": "form input[name='email']" },
        { "action": "tabs", "count": 3 }
      ]
    }
  ]
}
