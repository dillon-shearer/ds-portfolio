{
  "name": "about",
  "route": "/about",
  "reducedMotion": true,
  "viewports": [
    { "width": 360, "height": 800 },
    { "width": 1440, "height": 1000 }
  ],
  "states": [
    {
      "name": "loaded",
      "ready": "h1",
      "assertions": [
        {
          "kind": "text",
          "selector": "h1",
          "includes": "Dillon Shearer"
        },
        {
          "kind": "visible",
          "selector": "h2:has-text('Resume')"
        },
        {
          "kind": "visible",
          "selector": "h2:has-text('Certifications')"
        },
        {
          "kind": "visible",
          "selector": "a:has-text('View HTML') >> nth=0"
        },
        {
          "kind": "eval",
          "expression": "matchMedia('(prefers-reduced-motion: reduce)').matches",
          "equals": true
        }
      ],
      "actions": [
        { "action": "focus", "selector": "a:has-text('View HTML') >> nth=0" },
        { "action": "tabs", "count": 3 }
      ]
    }
  ]
}
