{
  "name": "links",
  "route": "/links",
  "reducedMotion": true,
  "viewports": [
    { "width": 320, "height": 900 },
    { "width": 390, "height": 900 },
    { "width": 720, "height": 1000 },
    { "width": 1080, "height": 1000 }
  ],
  "states": [
    {
      "name": "populated",
      "route": "/links?__uiState=sample",
      "ready": "h2:has-text('daily.writing.prompts0')",
      "assertions": [
        { "kind": "visible", "selector": "h1:has-text('Channels')" },
        { "kind": "count", "selector": "ul[aria-label='Channels'] > li", "equals": 3 },
        { "kind": "count", "selector": "ul[aria-label='Channels'] a", "equals": 6 },
        { "kind": "count", "selector": "a[href*='tiktok.com']", "equals": 0 },
        {
          "kind": "eval",
          "expression": "document.querySelectorAll('ul[aria-label=\"Channels\"] a[href*=\"youtube.com/@\"]').length",
          "equals": 3
        },
        {
          "kind": "eval",
          "expression": "document.querySelectorAll('ul[aria-label=\"Channels\"] a[href*=\"instagram.com/\"]').length",
          "equals": 3
        }
      ],
      "actions": [
        { "action": "focus", "selector": "ul[aria-label='Channels'] a >> nth=0" },
        { "action": "tabs", "count": 3 }
      ]
    },
    {
      "name": "empty",
      "route": "/links?__uiState=empty",
      "ready": "text=Links are not available right now.",
      "assertions": [
        { "kind": "count", "selector": "ul[aria-label='Channels'] > li", "equals": 0 },
        { "kind": "visible", "selector": "h1:has-text('Channels')" }
      ]
    }
  ]
}
