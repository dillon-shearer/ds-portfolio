# Public canonical site URL used for metadata and contact links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend API key used by the contact form.
RESEND_API_KEY=re_replace_with_your_key

# Neon pooled database connection used by the gym dashboard.
DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require

# Neon direct connection retained for migration tooling.
DATABASE_URL_UNPOOLED=postgres://user:password@host:5432/database?sslmode=require

# Read-only database connection used by gym chat in production.
GYM_CHAT_DATABASE_URL_READONLY=postgres://user:password@host:5432/database?sslmode=require

# Optional OpenAI API key alias recognized by gym chat.
GYM_CHAT_OPENAI_API_KEY=replace_with_your_openai_key

# Primary OpenAI API key used by gym chat.
OPENAI_API_KEY=replace_with_your_openai_key

# Optional OpenAI-compatible API base URL.
OPENAI_API_BASE_URL=https://api.openai.com/v1

# Optional gym chat model override.
GYM_CHAT_MODEL=gpt-4o

# Optional general OpenAI model override.
OPENAI_MODEL=gpt-4o

# Password required for the Log Workout tab.
LIFT_PASSWORD=replace_with_a_local_password

# Development fallback for a direct Postgres connection.
POSTGRES_URL_NON_POOLING=postgres://user:password@host:5432/database?sslmode=require

# Development fallback for a pooled Postgres connection.
POSTGRES_URL=postgres://user:password@host:5432/database?sslmode=require

# Optional connection used to load the gym chat schema.
GYM_CHAT_SCHEMA_URL=postgres://user:password@host:5432/database?sslmode=require
